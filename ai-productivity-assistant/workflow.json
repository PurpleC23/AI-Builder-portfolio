    {
      "parameters": {
        "promptType": "define",
        "text": "={\n  \"summary\": \"short summary\",\n  \"tasks\": [\n    {\n      \"task\": \"task description\",\n      \"type\": \"task or meeting\",\n      \"datetime\": \"YYYY-MM-DD\" or null,\n      \"category\": \"work | admin | personal | finance | learning\",\n      \"priority\": \"high | medium | low\",\n      \"source\": \"email sender\"\n    }\n  ]\n}",
        "messages": {
          "messageValues": [
            {
              "message": "=You analyze emails and extract actionable items.\n\nReturn VALID JSON only. Do not include explanations or text outside JSON.\n\nOutput format:\n\n{\n  \"summary\": \"short summary of the email\",\n  \"tasks\": [\n    {\n      \"task\": \"task description\",\n      \"type\": \"task or meeting\",\n      \"datetime\": \"YYYY-MM-DD\" or null\n    }\n  ]\n}\nCategory rules:\nWork → reports, meetings, projects\nAdmin → scheduling, paperwork\nPersonal → life tasks\nFinance → payments, invoices\nLearning → courses, study\nPriority rules:\n- urgent, asap, immediately → high\n- deadlines or scheduled work → medium\n- general tasks → low\nRules:\n- Identify all actionable items from the email.\n- If the item refers to a meeting, call, discussion, or scheduling → type = \"meeting\".\n- Otherwise type = \"task\".\n- Extract a deadline or date if present.\n- Convert dates to ISO 8601 format: YYYY-MM-DD.\n- If no date is mentioned → datetime = null.\n- Every string value must be in double quotes.\n- Output must be valid JSON.\n- Return STRICT JSON only.\n- Do NOT include markdown, explanations, or extra text.\n\nEmail:\n{{$json.Email}}"
            }
          ]
        },
        "batching": {}
      },
